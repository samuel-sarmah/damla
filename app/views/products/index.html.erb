<% content_for :title, "#{t('products.title')} — #{t('site.name')}" %>

<h1 class="text-3xl font-bold text-slate-900"><%= t("products.title") %></h1>

<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% @products.each do |product| %>
    <%= link_to product_path(product, locale: I18n.locale), class: "block rounded-lg border border-slate-200 p-5 hover:border-sky-400 hover:shadow-sm transition" do %>
      <h2 class="text-lg font-semibold text-slate-900"><%= product.name %></h2>
      <p class="mt-1 text-sm text-slate-500"><%= product.size_liters %> L</p>
      <p class="mt-3 text-xl font-semibold text-sky-700"><%= number_to_currency(product.base_price_try) %></p>
      <% if product.requires_deposit? %>
        <p class="mt-2 text-xs text-amber-700"><%= t("products.deposit_note") %></p>
      <% end %>
      <span class="mt-3 inline-block text-sm font-medium text-sky-700"><%= t("products.view_details") %> &rarr;</span>
    <% end %>
  <% end %>
</div>
