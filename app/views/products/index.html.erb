<% content_for :title, "#{t('products.title')} — #{t('site.name')}" %>

<div class="bg-white border-b border-slate-200">
  <div class="container mx-auto px-5 py-10">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= t("products.title") %></h1>
  </div>
</div>

<div class="container mx-auto px-5 py-10">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @products.each do |product| %>
      <%= link_to product_path(product, locale: I18n.locale),
            class: "group block rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-100 hover:ring-sky-300 hover:shadow-md transition" do %>
        <div class="flex items-start justify-between">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-sky-50 text-sky-700 group-hover:bg-sky-100">
            <%= icon :droplet, css_class: "w-6 h-6" %>
          </span>
          <% if product.requires_deposit? %>
            <span class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">
              <%= t("products.deposit_badge") %>
            </span>
          <% end %>
        </div>
        <h2 class="mt-4 text-lg font-semibold text-slate-900"><%= product.name %></h2>
        <p class="mt-1 text-sm text-slate-500"><%= product.size_liters %> L</p>
        <div class="mt-4 flex items-center justify-between">
          <p class="text-xl font-bold text-sky-700"><%= number_to_currency(product.base_price_try) %></p>
          <span class="inline-flex items-center gap-1 text-sm font-medium text-sky-700">
            <%= t("products.view_details") %>
            <%= icon :arrow_right, css_class: "w-4 h-4" %>
          </span>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
