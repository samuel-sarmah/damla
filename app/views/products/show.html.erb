<% content_for :title, "#{@product.name} — #{t('site.name')}" %>

<div class="container mx-auto px-5 py-10">
  <%= link_to products_path(locale: I18n.locale), class: "inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:text-sky-800" do %>
    <%= icon :arrow_right, css_class: "w-4 h-4 rotate-180" %>
    <%= t("products.title") %>
  <% end %>

  <div class="mt-6 grid gap-10 sm:grid-cols-2 items-start max-w-3xl">
    <div class="flex aspect-square items-center justify-center rounded-2xl bg-gradient-to-br from-sky-50 to-cyan-100 ring-1 ring-slate-100">
      <span class="flex h-28 w-28 items-center justify-center rounded-full bg-white text-sky-700 shadow-sm">
        <%= icon :droplet, css_class: "w-14 h-14" %>
      </span>
    </div>

    <div>
      <% if @product.requires_deposit? %>
        <span class="inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">
          <%= t("products.deposit_badge") %>
        </span>
      <% end %>
      <h1 class="mt-3 text-3xl font-bold text-slate-900"><%= @product.name %></h1>
      <p class="mt-1 text-slate-500"><%= @product.size_liters %> L</p>
      <p class="mt-4 text-3xl font-bold text-sky-700"><%= number_to_currency(@product.base_price_try) %></p>

      <% if @product.requires_deposit? %>
        <p class="mt-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-800 ring-1 ring-inset ring-amber-200"><%= t("products.deposit_note") %></p>
      <% end %>

      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to whatsapp_order_url(@product), target: "_blank", rel: "noopener",
              class: "inline-flex items-center gap-2 rounded-full bg-emerald-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-emerald-700" do %>
          <%= icon :chat, css_class: "w-5 h-5" %>
          <%= t("nav.order_whatsapp") %>
        <% end %>
        <%= link_to t("delivery_orders.title"), new_delivery_order_path(locale: I18n.locale),
              class: "inline-flex items-center gap-2 rounded-full border border-sky-700 px-5 py-2.5 font-semibold text-sky-700 hover:bg-sky-50" %>
      </div>
    </div>
  </div>
</div>
