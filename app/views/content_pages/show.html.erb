<% content_for :title, "#{@content_page.title} — #{t('site.name')}" %>

<div class="bg-white border-b border-slate-200">
  <div class="container mx-auto px-5 py-10 max-w-2xl">
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-sky-50 text-sky-700">
      <%= icon :shield_check, css_class: "w-6 h-6" %>
    </span>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900"><%= @content_page.title %></h1>
  </div>
</div>

<div class="container mx-auto px-5 py-10 max-w-2xl">
  <div class="rounded-xl bg-white p-6 sm:p-8 shadow-sm ring-1 ring-slate-100
              text-slate-700 leading-relaxed
              [&_h1]:text-xl [&_h1]:font-bold [&_h1]:text-slate-900 [&_h1]:mt-6 [&_h1]:mb-3
              [&_h2]:text-lg [&_h2]:font-bold [&_h2]:text-slate-900 [&_h2]:mt-6 [&_h2]:mb-2
              [&_p]:mb-4 [&_strong]:font-semibold [&_strong]:text-slate-900
              [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 [&_li]:mb-1
              [&_a]:text-sky-700 [&_a]:underline">
    <%= markdown(@content_page.body) %>
  </div>
</div>
