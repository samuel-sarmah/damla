<% content_for :title, "#{t('site.name')} — #{t('home.hero_title')}" %>

<section class="max-w-2xl">
  <h1 class="text-4xl font-bold tracking-tight text-slate-900"><%= t("home.hero_title") %></h1>
  <p class="mt-4 text-lg text-slate-600"><%= t("home.hero_subtitle") %></p>

  <div class="mt-6 flex gap-4">
    <%= link_to t("home.cta_products"), products_path(locale: I18n.locale),
          class: "inline-block rounded-md bg-sky-700 px-5 py-2.5 text-white font-medium hover:bg-sky-800" %>
    <%= link_to t("home.cta_delivery_check"), delivery_zone_check_path(locale: I18n.locale),
          class: "inline-block rounded-md border border-sky-700 px-5 py-2.5 text-sky-700 font-medium hover:bg-sky-50" %>
  </div>
</section>
