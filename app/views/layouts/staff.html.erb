<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "Personel Paneli" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="container mx-auto px-5 py-4 flex items-center justify-between">
        <%= link_to "Öz Su — Personel Paneli", staff_delivery_orders_path, class: "text-lg font-semibold text-sky-700" %>
        <nav class="flex items-center gap-4 text-sm font-medium text-slate-600">
          <%= link_to "Siparişler", staff_delivery_orders_path %>
          <%= link_to "Yeni Sipariş", new_staff_delivery_order_path %>
          <% if authenticated? %>
            <%= button_to "Çıkış Yap", staff_session_path, method: :delete, class: "text-slate-600 hover:text-sky-700 cursor-pointer" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container mx-auto px-5 py-8">
      <% if notice %>
        <p class="mb-6 rounded-md bg-emerald-50 p-4 text-emerald-800"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-6 rounded-md bg-red-50 p-4 text-red-800"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
